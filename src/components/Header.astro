<style>

    nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: black;
        padding: 10px 150px;
        height: 90px;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
    }

    .logo img {
        height: 57px;
        transition: transform 0.3s ease-in-out;
    }

    .logo img:hover {
        transform: scale(1.1);
        cursor: pointer;
    }

    .menu {
        display: flex;
        gap: 20px;
        align-items: center;
    }

    .menu .nav-link {
        color: white;
        text-decoration: none;
        padding: 5px 8px;
        text-transform: uppercase;
        font-size: 12px;
        border-radius: 15px;
        transition: background-color 0.2s ease-in-out, color 0.2s ease-in-out;
    }

    .menu .nav-link:hover {
        text-decoration: underline;
        color: white;
    }

    .idioma {
        position: relative;
    }

    .idioma button {
        display: flex;
        align-items: center;
    }

    .idioma-svg {
        width: 15px;
        height: 15px;
        margin: 0 2px;
    }

    #triangle {
        width: 12px;
        height: 12px;
        transition: transform 0.3s ease-in-out;
    }

    .idioma:hover button{
        cursor: pointer;
    }

    .idioma:hover #triangle {
        transform: rotate(180deg);
    }

    .dropdown {
        display: none;
        flex-direction: column;
        background-color: black;
        position: absolute;
        top: 100%;
        right: 0;
        z-index: 1;
        width: 45px;
        align-items: center;
        border-radius: 5px;
        padding-top: 15px;
    }

    .idioma:hover .dropdown {
        display: flex;
    }

    .dropdown svg {
        width: 35px;
        height: 35px;
        transition: scale 0.3s ease-in-out;
    }

    .dropdown svg:hover {
        cursor: pointer;
        transform: scale(1.1);
    }
</style>