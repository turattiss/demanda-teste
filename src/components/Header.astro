---
import logo from '../assets/imgs/logo.png';
const { t, isEnglish = false } = Astro.props;
---

<nav>
    <div class="logo">
        <a href={isEnglish ? '/en/' : '/'}>
            <img src={logo.src} alt="Logo" />
        </a>
    </div>

    <div class="menu">
        <a href={isEnglish ? '/en/#portfolio' : '/#portfolio'} class="nav-link">{t.header.portfolio}</a>
        <a href={isEnglish ? '/en/#servicos' : '/#servicos'} class="nav-link">{t.header.services}</a>
        <a href={isEnglish ? '/en/#sobre' : '/#sobre'} class="nav-link">{t.header.about}</a>
        <a href={isEnglish ? '/en/#orcamento' : '/#orcamento'} class="nav-link">{t.header.quote}</a>

        <div class="idioma">
            <button type="button" aria-label={t.header.language} aria-controls="idioma-dropdown" aria-expanded="false">
                <svg class="idioma-svg" fill="#fff" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="m24 12c0-.002 0-.004 0-.006 0-3.551-1.546-6.74-4.001-8.933l-.012-.01c-.031-.033-.064-.062-.101-.087l-.002-.001c-2.095-1.84-4.859-2.962-7.886-2.962-3.032 0-5.8 1.126-7.91 2.984l.013-.011c-.026.02-.049.041-.07.065v.001c-2.478 2.205-4.031 5.403-4.031 8.963 0 3.55 1.544 6.739 3.997 8.933l.012.01c0 .003.002.005.005.005.031.035.065.065.101.092l.002.001c2.094 1.837 4.857 2.958 7.881 2.958 3.032 0 5.801-1.126 7.911-2.984l-.013.011c.03-.022.056-.045.08-.07 2.475-2.202 4.026-5.395 4.026-8.951 0-.002 0-.005 0-.007zm-4.462 7.805c-.576-.468-1.223-.897-1.909-1.262l-.065-.032c.613-1.767.982-3.804 1.017-5.923v-.016h4.261c-.156 2.852-1.391 5.388-3.301 7.23zm-6.966-1.505c1.283.069 2.482.351 3.588.81l-.072-.026c-.886 2.02-2.133 3.408-3.516 3.713zm0-1.144v-4.584h4.868c-.043 1.961-.383 3.828-.976 5.578l.039-.131c-1.157-.484-2.498-.795-3.903-.862l-.027-.001zm0-5.728v-4.584c1.431-.069 2.772-.379 4.007-.891l-.079.029c.555 1.619.896 3.485.94 5.425v.021zm0-5.728v-4.495c1.383.305 2.63 1.687 3.516 3.713-1.034.43-2.233.711-3.487.781zm2.854-4c1.238.419 2.312 1.009 3.258 1.752l-.023-.018c-.443.348-.94.676-1.464.961l-.056.028c-.449-1.047-1.025-1.947-1.724-2.737l.009.011zm-4-.492v4.492c-1.283-.069-2.482-.35-3.588-.81l.072.026c.89-2.02 2.135-3.407 3.518-3.712zm-4.568 3.212c-.58-.315-1.077-.642-1.544-1.007l.024.018c.923-.726 1.996-1.315 3.158-1.712l.076-.023c-.689.778-1.265 1.678-1.689 2.658l-.025.065zm4.57 2.423v4.584h-4.868c.044-1.961.385-3.827.979-5.577l-.039.131c1.156.483 2.497.794 3.901.861zm0 5.728v4.584c-1.431.069-2.772.379-4.007.891l.079-.029c-.555-1.618-.896-3.485-.94-5.425v-.021zm0 5.728v4.495c-1.383-.305-2.63-1.687-3.516-3.713 1.034-.305 2.63-.71 3.487-.78l.029-.001zm-2.85 4c-1.238-.418-2.311-1.006-3.258-1.748l.024.018c.443-.348.94-.676 1.464-.961l.056-.028c.445 1.047 1.022 1.947 1.723 2.733l-.009-.01zm8.564-2.72c.58.315 1.077.642 1.544 1.007l-.024-.018c-.923.726-1.996 1.315-3.158 1.712l-.076.023c.689-.778 1.265-1.677 1.689-2.657l.025-.065zm5.7-8.151h-4.261c-.035-2.135-.404-4.172-1.058-6.078l.041.138c.751-.399 1.397-.828 1.997-1.312l-.024.018c1.913 1.845 3.148 4.381 3.303 7.205l.001.028zm-18.38-7.233c.576.468 1.223.897 1.909 1.262l.065.032c-.613 1.767-.982 3.804-1.017 5.923v.016h-4.262c.156-2.852 1.391-5.388 3.301-7.23l.003-.003zm-3.304 8.377h4.261c.035 2.135.404 4.172 1.058 6.078l-.041-.138c-.751.399-1.397.828-1.997 1.312l.024-.018c-1.913-1.845-3.148-4.381-3.303-7.205l-.001-.028z"></path></g></svg>

                <svg id="triangle" class="idioma-svg" fill="#fff" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 24 24" xml:space="preserve" stroke="#"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <style type="text/css"> .st0{fill:none;} </style> <path d="M6.5,8.5l6,7l6-7H6.5z"></path> <rect class="st0" width="24" height="24"></rect> <rect class="st0" width="24" height="24"></rect> </g></svg>
            </button>

            <div class="dropdown" id="idioma-dropdown" aria-hidden="true">
                <a href="/">
                    <svg viewBox="0 0 28 20" role="img" aria-label="Português do Brasil" xmlns="http://www.w3.org/2000/svg"><rect width="28" height="20" rx="2" fill="#05AB41" /><path d="M14 2.2 25 10 14 17.8 3 10z" fill="#FDD216" /><circle cx="14" cy="10" r="4.7" fill="#053087" /><path d="M9.7 8.8c2-.5 5.7.2 8.6 2" fill="none" stroke="#fff" stroke-width=".45" /></svg>
                </a>
                <a href="/en/">
                    <svg viewBox="0 0 28 20" role="img" aria-label="English" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="us-stripes" width="28" height="3.08" patternUnits="userSpaceOnUse"><rect width="28" height="1.54" fill="#B22234" /><rect y="1.54" width="28" height="1.54" fill="#fff" /></pattern><pattern id="us-stars" width="3" height="2.4" patternUnits="userSpaceOnUse"><circle cx="1.5" cy="1.2" r=".45" fill="#fff" /></pattern><clipPath id="us-flag-clip"><rect width="28" height="20" rx="2" /></clipPath></defs><g clip-path="url(#us-flag-clip)"><rect width="28" height="20" fill="url(#us-stripes)" /><rect width="12" height="10.8" fill="#3C3B6E" /><rect width="12" height="10.8" fill="url(#us-stars)" /></g></svg>
                </a>
            </div>
        </div>
    </div>

    <button class="menu-toggle" type="button" aria-label={t.header.menuOpen} data-menu-open={t.header.menuOpen} data-menu-close={t.header.menuClose} aria-controls="mobile-menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
    </button>
</nav>

<button class="menu-overlay" type="button" aria-label={t.header.menuClose} tabindex="-1"></button>

<aside id="mobile-menu" class="mobile-menu" aria-hidden="true" inert>
    <nav aria-label={t.header.menuOpen}>
        <a href={isEnglish ? '/en/#portfolio' : '/#portfolio'} class="nav-link">{t.header.portfolio}</a>
        <a href={isEnglish ? '/en/#servicos' : '/#servicos'} class="nav-link">{t.header.services}</a>
        <a href={isEnglish ? '/en/#sobre' : '/#sobre'} class="nav-link">{t.header.about}</a>
        <a href={isEnglish ? '/en/#orcamento' : '/#orcamento'} class="nav-link">{t.header.quote}</a>
    </nav>
</aside>

<script>
    const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
    const menuOverlay = document.querySelector<HTMLButtonElement>('.menu-overlay');
    const languageSelector = document.querySelector<HTMLElement>('.idioma');
    const languageToggle = languageSelector?.querySelector<HTMLButtonElement>('button');
    const languageDropdown = languageSelector?.querySelector<HTMLElement>('.dropdown');

    const setMenuOpen = (open: boolean) => {
        menuToggle?.setAttribute('aria-expanded', String(open));
        menuToggle?.setAttribute('aria-label', open ? (menuToggle.dataset.menuClose ?? '') : (menuToggle.dataset.menuOpen ?? ''));
        mobileMenu?.setAttribute('aria-hidden', String(!open));
        mobileMenu?.toggleAttribute('inert', !open);
        mobileMenu?.classList.toggle('aberto', open);
        menuOverlay?.classList.toggle('aberto', open);
        document.body.classList.toggle('menu-mobile-aberto', open);
    };

    menuToggle?.addEventListener('click', () => {
        setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
    });

    const setLanguageOpen = (open: boolean) => {
        languageToggle?.setAttribute('aria-expanded', String(open));
        languageDropdown?.setAttribute('aria-hidden', String(!open));
        languageSelector?.classList.toggle('aberto', open);
    };

    languageToggle?.addEventListener('click', () => {
        setLanguageOpen(languageToggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('click', (event) => {
        if (event.target instanceof Element && !event.target.closest('.idioma')) {
            setLanguageOpen(false);
        }
    });

    menuOverlay?.addEventListener('click', () => setMenuOpen(false));

    mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenuOpen(false));
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            setMenuOpen(false);
            setLanguageOpen(false);
        }
    });
</script>

<style>

    nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: black;
        padding: 10px clamp(1rem, 6vw, 6rem);
        height: 90px;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
    }

    .logo img {
        height: 57px;
        transition: transform 0.3s ease-in-out;
    }

    .logo img:hover {
        transform: scale(1.1);
        cursor: pointer;
    }

    .menu {
        display: flex;
        gap: 20px;
        align-items: center;
    }

    .menu .nav-link {
        color: white;
        text-decoration: none;
        padding: 5px 8px;
        text-transform: uppercase;
        font-size: 12px;
        border-radius: 15px;
        transition: background-color 0.2s ease-in-out, color 0.2s ease-in-out;
    }

    .menu .nav-link:hover {
        text-decoration: underline;
        color: white;
    }

    .idioma {
        position: relative;
    }

    .idioma button {
        display: flex;
        align-items: center;
    }

    .idioma-svg {
        width: 15px;
        height: 15px;
        margin: 0 2px;
    }

    #triangle {
        width: 12px;
        height: 12px;
        transition: transform 0.3s ease-in-out;
    }

    .idioma button {
        cursor: pointer;
    }

    .idioma.aberto #triangle {
        transform: rotate(180deg);
    }

    .dropdown {
        display: none;
        flex-direction: column;
        gap: 2px;
        background-color: black;
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        z-index: 1;
        min-width: 48px;
        align-items: center;
        border: 1px solid #444;
        border-radius: 8px;
        padding: 5px 4px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    }

    .dropdown a {
        display: block;
        width: 100%;
        padding: 5px 4px;
        border-radius: 4px;
        color: #fff;
        text-align: center;
        text-decoration: none;
    }

    .dropdown a:hover { 
        background: #333;
    }

    .idioma.aberto .dropdown {
        display: flex;
    }

    .dropdown svg {
        display: block;
        width: 36px;
        height: auto;
        transition: scale 0.3s ease-in-out;
    }

    .dropdown svg:hover {
        cursor: pointer;
        transform: scale(1.1);
    }

    .menu-toggle,
    .mobile-menu,
    .menu-overlay {
        display: none;
    }

    @media (max-width: 968px) {

        nav {
            height: 68px;
            min-height: 68px;
            padding: 0.6rem 1rem;
            align-items: center;
        }

        nav:has(.idioma.aberto) {
            z-index: 1003;
        }

        nav > .menu {
            display: flex;
            max-width: none;
            margin-left: auto;
            margin-right: 0.65rem;
            gap: 0;
        }

        nav > .menu > .nav-link {
            display: none;
        }

        .idioma {
            display: block;
        }

        .idioma button {
            padding: 0.45rem;
            border: 0;
            background: transparent;
        }

        .idioma-svg {
            width: 18px;
            height: 18px;
        }

        #triangle {
            width: 12px;
            height: 12px;
        }

        .logo img {
            height: 40px;
        }

        .menu-toggle {
            display: flex;
            width: 44px;
            height: 44px;
            padding: 10px;
            flex-direction: column;
            justify-content: center;
            gap: 5px;
            border-radius: 50%;
            background: transparent;
            cursor: pointer;
        }

        .menu-toggle span {
            display: block;
            width: 100%;
            height: 2px;
            background: #fff;
            transition: transform 0.25s ease, opacity 0.25s ease;
        }

        nav:has(.menu-toggle[aria-expanded="true"]) .menu-toggle span:first-child {
            transform: translateY(7px) rotate(45deg);
        }

        nav:has(.menu-toggle[aria-expanded="true"]) .menu-toggle span:nth-child(2) {
            opacity: 0;
        }

        nav:has(.menu-toggle[aria-expanded="true"]) .menu-toggle span:last-child {
            transform: translateY(-7px) rotate(-45deg);
        }

        .mobile-menu {
            display: block;
            position: fixed;
            z-index: 1001;
            top: 68px;
            right: 0;
            width: min(82vw, 360px);
            height: calc(100dvh - 68px);
            padding: 1rem 1.5rem;
            background: #000;
            box-shadow: -18px 12px 36px rgba(0, 0, 0, 0.35);
            transform: translateX(105%);
            visibility: hidden;
            transition: transform 0.5s ease, visibility 0.5s ease;
        }

        .mobile-menu nav {
            position: static;
            top: auto;
            left: auto;
            display: flex;
            z-index: auto;
            height: auto;
            min-height: 0;
            padding: 0;
            flex-direction: column;
            align-items: stretch;
            gap: 0.5rem;
            width: 100%;
            background: transparent;
        }

        .mobile-menu .nav-link {
            display: block;
            padding: 1rem 0.5rem;
            border-bottom: 1px solid #333;
            color: #fff;
            font-size: 0.95rem;
            text-decoration: none;
            text-transform: uppercase;
        }

        .menu-overlay {
            display: block;
            position: fixed;
            z-index: 999;
            inset: 68px 0 0;
            border: 0;
            background: rgba(0, 0, 0, 0.58);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }

        .mobile-menu.aberto {
            transform: translateX(0);
            visibility: visible;
        }

        .menu-overlay.aberto {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        :global(body.menu-mobile-aberto) {
            overflow: hidden;
        }
    }

    @media (max-width: 480px) {

        nav {
            padding-inline: 0.75rem;
        }

        .logo img {
            height: 36px;
        }

        nav > .menu {
            margin-right: 0.35rem;
        }

    }

</style>
