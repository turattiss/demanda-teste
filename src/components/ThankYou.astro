---
const { t } = Astro.props;
---

<div class="obrigado">
    <h1>{t.thankYou.heading}</h1>
    <p>{t.thankYou.message}</p>
</div>

<style>
    .obrigado {
        width: 100%;
        min-height: 70vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
        padding: 8rem 2rem;
    }

    .obrigado h1 {
        font-size: 6rem;
        letter-spacing: -1px;
        margin-bottom: 0.5rem;
    }

    .obrigado p {
        max-width: 550px;
        font-size: 1.1rem;
        line-height: 1.5;
        margin-bottom: 2rem;
    }

    @media (max-width: 600px) {
        .obrigado {
            min-height: 60vh;
            padding: 6rem 1.25rem;
        }

        .obrigado h1 {
            font-size: clamp(3rem, 16vw, 5rem);
        }
    }
</style>
